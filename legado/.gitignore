# Dependências
/vendor/

# Configuração local e segredos
/.env
/.env.*
!/.env.example
/storage/chaves/*
!/storage/chaves/.gitkeep
*.key
*.pem

# Logs e cache
/storage/logs/*
!/storage/logs/.gitkeep
/.phpunit.cache/
/.phpcs-cache

# Dados biométricos ou fotos NUNCA entram no repositório
*.tpl
*.bio
/storage/fotos/

# IDE / SO
/.idea/
/.vscode/
Thumbs.db
.DS_Store

# E-mails gravados em arquivo no desenvolvimento (contêm dados pessoais)
/storage/emails/
