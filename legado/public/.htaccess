# Pasta pública: única exposta pelo Apache.
# Reabre o acesso que o .htaccess da raiz do projeto bloqueia.
Require all granted

Options -Indexes -MultiViews
DirectoryIndex index.php

# Limite do corpo da requisição (10 MB): foto facial vai até 5 MB; o resto é bem menor.
# Evita que uploads gigantes (o php.ini do Laragon aceita 2 GB) consumam o servidor.
LimitRequestBody 10485760

# Repassa o cabeçalho Authorization (token das catracas) ao PHP.
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Arquivos e pastas reais (css, js, imagens) são servidos diretamente.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo o resto vai para o front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Arquivos ocultos (.htaccess, .git etc.) nunca são servidos.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
