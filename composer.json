{
    "name": "vsceno/cadgestor",
    "description": "CadGestor - controle de acesso e cadastro de pessoas vinculadas a empresas",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-pgsql": "*",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "CadGestor\\": "src/"
        },
        "files": [
            "src/Nucleo/funcoes.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "CadGestor\\Testes\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
