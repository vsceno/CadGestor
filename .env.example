# =============================================================================
# CadGestor - variáveis de ambiente
# Copie para .env e ajuste. NUNCA commite o .env (ele já está no .gitignore).
# =============================================================================

# --- Aplicação --------------------------------------------------------------
# desenvolvimento | teste | producao
APP_AMBIENTE=desenvolvimento
# true exibe detalhes de erro na tela (ignorado quando APP_AMBIENTE=producao)
APP_DEBUG=true
APP_URL=http://cadgestor.test
# Fuso usado nas regras de horário de acesso e na exibição
APP_FUSO=America/Fortaleza

# --- Banco de dados (usuário da APLICAÇÃO: só lê e grava dados) -------------
DB_HOST=127.0.0.1
DB_PORTA=5432
DB_BANCO=cadgestor
DB_SCHEMA=cadgestor
DB_USUARIO=cadgestor_app
DB_SENHA=troque-esta-senha

# --- Banco de dados (usuário de MIGRAÇÃO: dono do schema) - Fase 1 ----------
DB_MIGRACAO_USUARIO=cadgestor_owner
DB_MIGRACAO_SENHA=troque-esta-senha

# --- Segurança - Fases 2 e 6 -------------------------------------------------
# Segredo para HMAC de identificadores técnicos (ex.: e-mail em tentativas de
# login). 64 caracteres hexadecimais. Gere com:
#   php -r "echo bin2hex(random_bytes(32));"
APP_SEGREDO=
# Cookie de sessão só por HTTPS. Use true em produção (exige SSL).
SESSAO_SEGURA=false
# Minutos sem uso até a sessão expirar.
SESSAO_INATIVIDADE_MINUTOS=30
# Caminho do arquivo com a chave de cifra dos templates biométricos.
# Deve ficar FORA de public/ e fora do banco. Gerada por script na Fase 6.
CHAVE_CIFRA_ARQUIVO=storage/chaves/biometria.key

# --- LGPD - Fase 9 -----------------------------------------------------------
# Dias após o fim do vínculo para excluir biometria e dados pessoais.
# PROVISÓRIO: prazo definitivo deve ser validado pelo jurídico do cliente.
RETENCAO_DIAS=30
